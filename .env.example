HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/realm.sqlite
# For a deployed instance, set the exact public origin (no trailing slash).
# PUBLIC_ORIGIN=https://your-app.example.com
# Set true when serving through HTTPS; keep false for local HTTP.
COOKIE_SECURE=false
# Optional. The chat works without an AI key. Never put this in VITE_* variables.
# OPENROUTER_API_KEY=
AI_MODEL=openrouter/free
